# ---------- Generation ----------
# local  = keyless deterministic demo (no model call, heuristic tool selection)
# openai = hosted OpenAI-compatible API
# vllm   = self-hosted vLLM OpenAI-compatible server
PROVIDER=local
OPENAI_API_KEY=API_KEYS
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Used when the primary provider fails. Set to "none" to disable.
FALLBACK_PROVIDER=openai
FALLBACK_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# onnx   = BAAI/bge-small-en-v1.5 on ONNX Runtime, no API key (default)
# openai = hosted text-embedding-3-small
# hash   = deterministic test double, no downloads
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CACHE_DIR=.cache/fastembed

# ---------- Retrieval ----------
DATA_DIR=data
CHROMA_DIR=data/chroma
COLLECTION_NAME=knowledge
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
TOP_K=4
MIN_SCORE=0.15

# ---------- Tools ----------
MAX_TOOL_ITERATIONS=4

# ---------- Reliability / performance ----------
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_LLM_CALLS=8
